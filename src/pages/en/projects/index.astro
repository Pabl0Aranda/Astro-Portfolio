---
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../../components/ProjectCard.astro";
import { getGitHubStats } from "../../../utils/github";

const proyectos = await getCollection("proyectos");
const proyectosOrdenados = proyectos.sort(
  (a, b) => (a.data.orden || 0) - (b.data.orden || 0),
);

// Obtenemos estadísticas de GitHub en build-time para cada proyecto
const proyectosConStats = await Promise.all(
  proyectosOrdenados.map(async (p) => {
    const stats = p.data.link ? await getGitHubStats(p.data.link) : null;
    return {
      ...p,
      githubStats: stats,
    };
  }),
);

// Extraer todas las tecnologías únicas
const allTechsSet = new Set<string>();
proyectosOrdenados.forEach((p) => {
  const parts = p.data.tech.split(/[,•\uFFFD\?]+/).map((t) => t.trim()).filter(Boolean);
  parts.forEach((t) => {
    if (t.length > 1 && !t.includes("")) {
      allTechsSet.add(t);
    }
  });
});

const topTechs = [
  "Python",
  "Java",
  "Astro",
  "TypeScript",
  "Docker",
  "Django",
  "Angular",
  "Odoo",
  "Algoritmia",
];

const filterCategories = [
  "All",
  ...topTechs.filter((t) =>
    Array.from(allTechsSet).some((tech) =>
      tech.toLowerCase().includes(t.toLowerCase()),
    ),
  ),
];
---

<Layout
  title="Software & Machine Learning Projects | Pablo Aranda"
  description="Showcase of full-stack engineering, machine learning, algorithms, and distributed systems projects by Pablo Aranda."
>
  <section class="reveal-text py-20 md:py-32">
    <!-- Header -->
    <header class="mb-14">
      <div class="mb-6">
        <a
          href="/en/#proyectos"
          class="text-albero inline-flex items-center text-sm font-semibold transition-colors duration-300 hover:text-neutral-900 dark:hover:text-white"
        >
          <svg
            class="mr-2 h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to home
        </a>
      </div>

      <h1
        class="mb-6 text-4xl font-bold tracking-tight text-neutral-900 md:text-6xl dark:text-white"
      >
        My <span class="text-albero">Projects</span>.
      </h1>
      <p class="max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">
        A curated selection of backend architectures, Machine Learning models,
        concurrent computing, and modern web solutions.
      </p>
    </header>

    <!-- Filters & Search Bar -->
    <div
      class="mb-10 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between"
    >
      <!-- Filter Pills -->
      <div class="flex flex-wrap items-center gap-2" id="tech-filters">
        {
          filterCategories.map((tech, idx) => (
            <button
              class={`filter-pill rounded-full px-4 py-2 text-xs md:text-sm font-semibold transition-all duration-300 ${
                idx === 0
                  ? "active bg-albero text-black shadow-md"
                  : "border border-neutral-200 bg-neutral-50 text-neutral-700 hover:border-albero hover:text-albero dark:border-white/10 dark:bg-white/5 dark:text-neutral-300"
              }`}
              data-tech={tech === "All" ? "all" : tech.toLowerCase()}
            >
              {tech}
            </button>
          ))
        }
      </div>

      <!-- Project counter -->
      <div
        id="projects-count"
        class="text-sm font-medium text-neutral-500 dark:text-neutral-400"
      >
        Showing <span class="font-bold text-neutral-900 dark:text-white"
          >{proyectosOrdenados.length}</span
        > projects
      </div>
    </div>

    <!-- Projects Grid -->
    <div
      id="projects-grid"
      class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        proyectosConStats.map((proyecto) => (
          <div
            class="project-item h-full transition-all duration-300"
            data-tech-list={proyecto.data.tech.toLowerCase()}
            data-title={proyecto.data.title.toLowerCase()}
          >
            <ProjectCard
              title={proyecto.data.title}
              description={proyecto.data.description}
              tech={proyecto.data.tech}
              link={`/projects/${proyecto.slug}`}
              repoUrl={proyecto.data.link}
              stats={proyecto.githubStats}
              size="medium"
              class="h-full"
            />
          </div>
        ))
      }
    </div>

    <!-- Empty State -->
    <div
      id="no-projects-msg"
      class="hidden flex-col items-center justify-center py-20 text-center"
    >
      <div
        class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-neutral-100 text-neutral-400 dark:bg-white/5"
      >
        <svg
          class="h-8 w-8"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          ></path>
        </svg>
      </div>
      <h3
        class="text-lg font-bold text-neutral-800 md:text-xl dark:text-neutral-200"
      >
        No projects found
      </h3>
      <p class="mt-2 text-sm text-neutral-500">
        Try selecting another technology filter to see more results.
      </p>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const filterPills = document.querySelectorAll<HTMLButtonElement>(".filter-pill");
    const projectItems = document.querySelectorAll<HTMLElement>(".project-item");
    const countSpan = document.querySelector("#projects-count span");
    const noProjectsMsg = document.getElementById("no-projects-msg");

    if (!filterPills.length || !projectItems.length) return;

    filterPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        filterPills.forEach((p) => {
          p.classList.remove("active", "bg-albero", "text-black", "shadow-md");
          p.classList.add(
            "border",
            "border-neutral-200",
            "bg-neutral-50",
            "text-neutral-700",
            "dark:border-white/10",
            "dark:bg-white/5",
            "dark:text-neutral-300",
          );
        });

        pill.classList.add("active", "bg-albero", "text-black", "shadow-md");
        pill.classList.remove(
          "border",
          "border-neutral-200",
          "bg-neutral-50",
          "text-neutral-700",
          "dark:border-white/10",
          "dark:bg-white/5",
          "dark:text-neutral-300",
        );

        const filter = pill.getAttribute("data-tech") || "all";
        let visibleCount = 0;

        projectItems.forEach((item) => {
          const techList = item.getAttribute("data-tech-list") || "";

          if (filter === "all" || techList.includes(filter)) {
            item.style.display = "";
            visibleCount++;
          } else {
            item.style.display = "none";
          }
        });

        if (countSpan) {
          countSpan.textContent = visibleCount.toString();
        }

        if (noProjectsMsg) {
          if (visibleCount === 0) {
            noProjectsMsg.classList.remove("hidden");
            noProjectsMsg.classList.add("flex");
          } else {
            noProjectsMsg.classList.remove("flex");
            noProjectsMsg.classList.add("hidden");
          }
        }
      });
    });
  });
</script>

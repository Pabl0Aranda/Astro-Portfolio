---
import Layout from "../layouts/Layout.astro";

import Hero from "../components/sections/Hero.astro";
import Experience from "../components/sections/Experience.astro";
import Education from "../components/sections/Education.astro";
import Skills from "../components/sections/Skills.astro";
import Projects from "../components/sections/Projects.astro";
import Others from "../components/sections/Others.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/Footer.astro";

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://pabloaranda.net/#person",
      "name": "Pablo Aranda",
      "alternateName": ["Pablo Aranda Cortés", "Pabl0Aranda"],
      "url": "https://pabloaranda.net",
      "image": "https://pabloaranda.net/og-image.jpg",
      "jobTitle": "Ingeniero de Software & Machine Learning Specialist",
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Universidad Pablo de Olavide"
      },
      "sameAs": [
        "https://github.com/Pabl0Aranda",
        "https://www.linkedin.com/in/pablo-aranda-cort%C3%A9s-348783350/"
      ],
      "knowsAbout": [
        "Machine Learning",
        "Deep Learning",
        "Software Engineering",
        "Algorithms",
        "Artificial Intelligence",
        "Python",
        "Java",
        "Astro"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://pabloaranda.net/#website",
      "url": "https://pabloaranda.net",
      "name": "Pablo Aranda",
      "description": "Portfolio y blog de ingeniería de software y Machine Learning de Pablo Aranda.",
      "publisher": {
        "@id": "https://pabloaranda.net/#person"
      },
      "inLanguage": "es"
    }
  ]
});
---

<Layout
  title="Pablo Aranda | Desarrollador de Software & Machine Learning"
  description="Pablo Aranda — Ingeniero de Software enfocado en Machine Learning, algoritmia y sistemas distribuidos. Portfolio de proyectos, experiencia y blog técnico."
  structuredData={structuredData}
>
  <Hero />
  <Education />
  <Skills />
  <Projects />
  <Experience />
  <Others />
  <Contact />
  <Footer />
</Layout>

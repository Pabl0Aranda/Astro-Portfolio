---
// RoutingSimulator.astro
---

<div
  class="routing-container relative mx-auto my-12 flex h-[450px] w-full max-w-3xl flex-col overflow-hidden rounded-3xl border-[6px] border-neutral-900 bg-[#0a0a0a] font-sans shadow-2xl ring-1 ring-white/10 md:h-[500px] md:rounded-[2.5rem]"
>
  <!-- Header -->
  <div
    class="flex items-center justify-between border-b border-white/5 bg-[#121212] px-6 py-4"
  >
    <div class="flex items-center gap-2">
      <div class="h-3 w-3 rounded-full bg-red-500"></div>
      <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
      <div class="h-3 w-3 rounded-full bg-green-500"></div>
    </div>
    <div class="text-sm font-medium text-neutral-400">
      DNS Anycast & Edge Routing Simulator
    </div>
    <div class="h-4 w-4 text-neutral-600">
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
        ></path></svg
      >
    </div>
  </div>

  <!-- Simulation Area -->
  <div
    class="relative flex-1 overflow-hidden bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#1a1a2e] via-[#0a0a0a] to-[#0a0a0a] p-8"
  >
    <!-- Grid Background -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"
    >
    </div>

    <!-- Nodes -->
    <div class="relative h-full w-full">
      <!-- User Node -->
      <div class="absolute bottom-6 left-6 flex flex-col items-center">
        <div
          id="user-node"
          class="z-10 flex h-14 w-14 items-center justify-center rounded-2xl border border-blue-500/50 bg-blue-500/10 shadow-[0_0_15px_rgba(59,130,246,0.3)] transition-all"
        >
          <svg
            class="h-7 w-7 text-blue-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            ></path></svg
          >
        </div>
        <span class="mt-2 text-xs font-semibold text-blue-400">Cliente Web</span
        >
      </div>

      <!-- DNS Server Node -->
      <div
        class="absolute top-6 left-1/2 flex -translate-x-1/2 flex-col items-center"
      >
        <div
          id="dns-node"
          class="z-10 flex h-14 w-14 items-center justify-center rounded-2xl border border-purple-500/50 bg-purple-500/10 shadow-[0_0_15px_rgba(168,85,247,0.0)] transition-all"
        >
          <svg
            class="h-7 w-7 text-purple-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
            ></path></svg
          >
        </div>
        <span class="mt-2 text-xs font-semibold text-purple-400"
          >Netlify DNS</span
        >
      </div>

      <!-- Edge Nodes -->
      <div class="absolute right-6 bottom-16 flex flex-col items-center">
        <div
          id="edge-node-1"
          class="z-10 flex h-14 w-14 items-center justify-center rounded-2xl border border-green-500/50 bg-green-500/10 shadow-[0_0_15px_rgba(34,197,94,0.0)] transition-all"
        >
          <svg
            class="h-7 w-7 text-green-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
            ></path></svg
          >
        </div>
        <span class="mt-2 text-xs font-semibold text-green-400">Edge Node</span>
      </div>

      <div
        class="absolute top-20 right-20 flex flex-col items-center opacity-40"
      >
        <div
          class="z-10 flex h-12 w-12 items-center justify-center rounded-2xl border border-neutral-500/50 bg-neutral-500/10"
        >
          <svg
            class="h-6 w-6 text-neutral-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
            ></path></svg
          >
        </div>
        <span class="mt-2 text-[10px] font-semibold text-neutral-400"
          >Far Node</span
        >
      </div>

      <!-- Packet -->
      <div
        class="packet-node absolute top-0 left-0 z-20 h-2.5 w-2.5 rounded-full bg-white opacity-0 shadow-[0_0_10px_#fff] transition-all duration-[800ms] ease-in-out"
      >
      </div>
    </div>
  </div>

  <!-- Controls -->
  <div
    class="flex flex-col items-center justify-between gap-4 border-t border-white/5 bg-[#121212] p-4 sm:flex-row"
  >
    <div class="w-full flex-1">
      <div
        id="status-text"
        class="font-mono text-xs tracking-wide text-neutral-400"
      >
        Estado: <span class="text-neutral-500">Inactivo</span>
      </div>
      <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-neutral-800">
        <div
          id="progress-bar"
          class="h-1 w-0 rounded-full bg-blue-500 transition-all duration-300"
        >
        </div>
      </div>
    </div>
    <button
      id="btn-simulate"
      class="group relative w-full overflow-hidden rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-lg transition-all hover:bg-blue-500 hover:shadow-[0_0_20px_rgba(59,130,246,0.3)] active:scale-95 sm:w-auto"
    >
      <span class="relative z-10 flex items-center justify-center gap-2">
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
        >
        Simular Petición
      </span>
    </button>
  </div>
</div>

<style>
  .node-active {
    animation: pulse-glow 1.5s ease-out;
  }

  @keyframes pulse-glow {
    0% {
      box-shadow: 0 0 0 0 rgba(var(--glow-color), 0.6);
    }
    70% {
      box-shadow: 0 0 0 20px rgba(var(--glow-color), 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(var(--glow-color), 0);
    }
  }
</style>

<script>
  document.querySelectorAll(".routing-container").forEach((container) => {
    const btnSimulate = container.querySelector("#btn-simulate");
    const statusText = container.querySelector("#status-text");
    const progressBar = container.querySelector("#progress-bar");
    const packet = container.querySelector(".packet-node");
    const userNode = container.querySelector("#user-node");
    const dnsNode = container.querySelector("#dns-node");
    const edgeNode = container.querySelector("#edge-node-1");

    const nodesContainer = packet.parentElement;
    let isSimulating = false;

    function sleep(ms) {
      return new Promise((resolve) => setTimeout(resolve, ms));
    }

    function getCenter(node) {
      const parentRect = nodesContainer.getBoundingClientRect();
      const nodeRect = node.getBoundingClientRect();
      const x = nodeRect.left - parentRect.left + nodeRect.width / 2;
      const y = nodeRect.top - parentRect.top + nodeRect.height / 2;
      return { x, y };
    }

    function movePacketTo(node, color) {
      const { x, y } = getCenter(node);
      // Subtract half of packet size (10px / 2 = 5px) to center it perfectly
      packet.style.transform = `translate(${x - 5}px, ${y - 5}px)`;
      packet.style.backgroundColor = color;
      packet.style.boxShadow = `0 0 15px ${color}`;
    }

    async function runSimulation() {
      if (isSimulating) return;
      isSimulating = true;
      btnSimulate.classList.add("opacity-50", "cursor-not-allowed");

      // Reset state
      packet.style.transition = "none";
      packet.style.opacity = "0";
      progressBar.style.width = "0%";
      dnsNode.style.setProperty("--glow-color", "168, 85, 247");
      edgeNode.style.setProperty("--glow-color", "34, 197, 94");

      // 1. Initial State (User)
      statusText.innerHTML =
        'Estado: <span class="text-blue-400">Iniciando conexión a pabloaranda.net...</span>';
      progressBar.style.width = "10%";
      movePacketTo(userNode, "#60a5fa");

      // Force reflow to apply transform before enabling transition
      void packet.offsetWidth;
      packet.style.transition = "";
      packet.style.opacity = "1";
      await sleep(600);

      // 2. To DNS Server
      statusText.innerHTML =
        'Estado: <span class="text-purple-400">Consultando IP Anycast en Netlify DNS...</span>';
      progressBar.style.width = "40%";
      movePacketTo(dnsNode, "#c084fc");

      await sleep(800);
      dnsNode.classList.remove("node-active");
      void dnsNode.offsetWidth; // trigger reflow
      dnsNode.classList.add("node-active");
      await sleep(800);

      // 3. To Edge Node
      statusText.innerHTML =
        'Estado: <span class="text-green-400">Enrutado óptimo al Edge Node más cercano...</span>';
      progressBar.style.width = "70%";
      movePacketTo(edgeNode, "#4ade80");

      await sleep(800);
      edgeNode.classList.remove("node-active");
      void edgeNode.offsetWidth;
      edgeNode.classList.add("node-active");
      await sleep(800);

      // 4. Back to User
      statusText.innerHTML =
        'Estado: <span class="text-blue-400">Sirviendo bundle estático. TTFB: 21ms</span>';
      progressBar.style.width = "100%";
      movePacketTo(userNode, "#60a5fa");

      await sleep(800);
      packet.style.opacity = "0";

      statusText.innerHTML =
        'Estado: <span class="text-white">Carga completada de forma asíncrona.</span>';

      isSimulating = false;
      btnSimulate.classList.remove("opacity-50", "cursor-not-allowed");
    }

    btnSimulate.addEventListener("click", runSimulation);
  });
</script>

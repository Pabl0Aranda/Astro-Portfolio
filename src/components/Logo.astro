---
const { class: className = "" } = Astro.props;
---

<div class={`flex items-center justify-center ${className}`}>
  <svg
    class="h-10 w-10 md:h-12 md:w-12"
    viewBox="10 10 80 80"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Bracket Izquierdo `<` -->
    <path
      d="M 30 30 L 14 50 L 30 70"
      stroke="currentColor"
      stroke-width="8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-neutral-400 dark:text-neutral-600"></path>

    <!-- Bracket Derecho `>` -->
    <path
      d="M 70 30 L 86 50 L 70 70"
      stroke="currentColor"
      stroke-width="8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-neutral-400 dark:text-neutral-600"></path>

    <!-- Letra P -->
    <path
      d="M 42 70 V 30 H 52 C 58 30 62 34 62 42 C 62 50 58 54 52 54 H 42"
      stroke="currentColor"
      stroke-width="8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-albero"></path>

    <!-- Cursor Terminal -->
    <path
      d="M 54 70 H 64"
      stroke="currentColor"
      stroke-width="8"
      stroke-linecap="round"
      class="text-albero animate-[pulse_1.5s_ease-in-out_infinite]"></path>
  </svg>
</div>

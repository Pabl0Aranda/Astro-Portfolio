---

<section
  id="habilidades"
  class="border-t border-neutral-200 py-20 dark:border-white/10"
>
  <div
    class="mb-10 flex flex-col justify-between gap-4 md:flex-row md:items-center"
  >
    <h2 class="reveal-text text-3xl font-bold text-neutral-900 dark:text-white">
      {t("skills.title")}
    </h2>

    {/* Dropdown Custom Estilizado */}
    <div class="relative w-full md:w-72" id="custom-skills-dropdown">
      <button
        type="button"
        id="dropdown-toggle"
        class="group hover:border-albero/50 focus:border-albero dark:hover:border-albero/50 dark:focus:border-albero flex w-full cursor-pointer items-center justify-between rounded-2xl border-2 border-neutral-200 bg-white/50 py-3 pr-4 pl-11 text-sm font-semibold text-neutral-800 backdrop-blur-sm transition-all duration-300 outline-none focus:bg-white focus:shadow-[0_0_15px_rgba(229,177,58,0.2)] dark:border-white/10 dark:bg-neutral-900/50 dark:text-neutral-200 dark:focus:bg-neutral-900"
      >
        <div
          class="pointer-events-none absolute inset-y-0 left-4 flex items-center"
        >
          <Icon name="mdi:filter-variant" class="text-albero h-5 w-5" />
        </div>

        <span id="dropdown-selected-text">Todas</span>

        <svg
          id="dropdown-arrow"
          class="text-albero h-5 w-5 transition-transform duration-300"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </button>

      {/* Menu Desplegable Flotante */}
      <ul
        id="dropdown-menu"
        class="invisible absolute z-30 mt-2 w-full origin-top-right scale-95 rounded-2xl border border-neutral-200 bg-white/95 p-2 opacity-0 shadow-xl backdrop-blur-md transition-all duration-200 dark:border-white/10 dark:bg-neutral-900/95"
      >
        {
          categories.map((cat) => (
            <li>
              <button
                type="button"
                data-value={cat.id}
                class="dropdown-option hover:bg-albero/10 hover:text-albero dark:hover:bg-albero/20 dark:hover:text-albero w-full rounded-xl px-4 py-2.5 text-left text-sm font-medium text-neutral-700 transition-colors dark:text-neutral-300"
              >
                {cat.label}
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div id="skills-container" class="flex flex-col gap-10">
    {
      categories
        .filter((c) => c.id !== "all")
        .map((cat) => {
          const catSkills = skillsData.filter((s) => s.category === cat.id);

          if (catSkills.length === 0) return null;

          return (
            <div class="skill-category-group" data-category={cat.id}>
              <h4 class="text-albero reveal-text mb-4 flex items-center gap-2 text-xl font-bold opacity-80">
                <span class="bg-albero/50 inline-block h-px w-6" />
                {cat.label}
              </h4>
              <div class="flex flex-wrap gap-4">
                {catSkills.map((skill) => (
                  <div class="skill-pill group hover:border-albero hover:bg-albero dark:hover:bg-albero relative flex cursor-default items-center gap-2 rounded-full border border-neutral-300 px-5 py-2 text-sm font-medium text-neutral-900 transition-all duration-300 hover:text-neutral-900 dark:border-white/10 dark:text-white dark:hover:text-neutral-900">
                    {skill.icon && (
                      <Icon
                        name={skill.icon}
                        class="h-4 w-4 transition-colors"
                      />
                    )}
                    <span>{skill.name}</span>

                    {/* Tooltip: alineación perfecta mediante flexbox y width completo */}
                    <div class="skill-tooltip pointer-events-none absolute bottom-full left-0 z-20 mb-3 flex w-full justify-center">
                      <div class="bg-albero relative w-max max-w-[220px] rounded-lg px-3 py-2 text-center text-xs font-semibold text-neutral-900 shadow-lg">
                        {skill.tooltip}
                        {/* Flecha del tooltip */}
                        <div class="bg-albero absolute -bottom-1 left-1/2 h-2.5 w-2.5 -translate-x-1/2 rotate-45" />
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })
    }
  </div>
</section>

<style>
  /* CSS Puro para controlar visibilidad y animación vertical */
  .skill-tooltip {
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .skill-pill:hover .skill-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
</style>

<script>
  function initSkillsFilter() {
    const dropdown = document.getElementById("custom-skills-dropdown");
    if (!dropdown) return;

    const toggleBtn = document.getElementById("dropdown-toggle");
    const menu = document.getElementById("dropdown-menu");
    const arrow = document.getElementById("dropdown-arrow");
    const selectedText = document.getElementById("dropdown-selected-text");
    const options = document.querySelectorAll(".dropdown-option");
    const categoryGroups = document.querySelectorAll(".skill-category-group");

    // Toggle menu
    toggleBtn.addEventListener("click", () => {
      const isExpanded = menu.classList.contains("opacity-100");
      if (isExpanded) {
        closeDropdown();
      } else {
        openDropdown();
      }
    });

    function openDropdown() {
      menu.classList.remove("opacity-0", "invisible", "scale-95");
      menu.classList.add("opacity-100", "visible", "scale-100");
      arrow.style.transform = "rotate(180deg)";
    }

    function closeDropdown() {
      menu.classList.remove("opacity-100", "visible", "scale-100");
      menu.classList.add("opacity-0", "invisible", "scale-95");
      arrow.style.transform = "rotate(0deg)";
    }

    // Close when clicking outside
    document.addEventListener("click", (e) => {
      if (!dropdown.contains(e.target as Node)) {
        closeDropdown();
      }
    });

    // Handle option click
    options.forEach((option) => {
      option.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const selectedFilter = target.getAttribute("data-value");
        const labelText = target.textContent?.trim() || "";

        // Update selected text
        if (selectedText) selectedText.textContent = labelText;

        // Close menu
        closeDropdown();

        // Filter groups
        categoryGroups.forEach((group: Element) => {
          const cat = group.getAttribute("data-category");
          const htmlGroup = group as HTMLElement;

          if (selectedFilter === "all" || selectedFilter === cat) {
            htmlGroup.style.display = "block";
            // Pequeña animación de entrada
            htmlGroup.style.animation = "fadeIn 0.5s ease-in-out forwards";
          } else {
            htmlGroup.style.display = "none";
          }
        });
      });
    });
  }

  // Define simple fade animation
  const style = document.createElement("style");
  style.innerHTML = `
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  `;
  document.head.appendChild(style);

  // Initialize on script load
  initSkillsFilter();

  // If using view transitions, re-initialize after swap
  document.addEventListener("astro:after-swap", initSkillsFilter);
</script>

---
import { getLangFromUrl } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
---

<div
  id="terminal-modal"
  class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/70 p-4 opacity-0 backdrop-blur-md transition-opacity duration-300"
  aria-modal="true"
  role="dialog"
>
  <div
    id="terminal-window"
    class="flex h-[550px] w-full max-w-3xl scale-95 flex-col overflow-hidden rounded-2xl border border-white/20 bg-[#0d1117] font-mono text-sm text-neutral-200 shadow-[0_20px_50px_rgba(0,0,0,0.8)] transition-all duration-300"
  >
    <!-- Window Header -->
    <div
      class="flex select-none items-center justify-between border-b border-white/10 bg-[#161b22] px-4 py-3"
    >
      <div class="flex items-center gap-2">
        <button
          id="terminal-btn-close"
          class="h-3 w-3 rounded-full bg-red-500 transition-opacity hover:opacity-80"
          aria-label="Cerrar terminal"
          title="Cerrar"
        ></button>
        <button
          id="terminal-btn-min"
          class="h-3 w-3 rounded-full bg-yellow-500 transition-opacity hover:opacity-80"
          aria-label="Minimizar"
          title="Minimizar"
        ></button>
        <button
          id="terminal-btn-max"
          class="h-3 w-3 rounded-full bg-green-500 transition-opacity hover:opacity-80"
          aria-label="Maximizar"
          title="Maximizar"
        ></button>
      </div>

      <div class="flex items-center gap-2 text-xs text-neutral-400 font-medium">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>pablo@portfolio:~ (bash)</span>
      </div>

      <div class="text-[11px] text-neutral-500">ESC to exit</div>
    </div>

    <!-- Terminal Content Area -->
    <div
      id="terminal-screen"
      class="flex-1 overflow-y-auto p-4 leading-relaxed scrollbar-thin scrollbar-thumb-white/10"
    >
      <div id="terminal-history" class="space-y-3">
        <!-- Welcome banner -->
        <div class="text-neutral-400">
          <p class="text-albero font-bold">
            Welcome to Pablo Aranda's Shell (Ubuntu 24.04 LTS x86_64)
          </p>
          <p class="mt-1 text-xs text-neutral-500">
            Type <span class="text-green-400 font-semibold">'help'</span> for available commands or <span class="text-green-400 font-semibold">'neofetch'</span> for system overview.
          </p>
        </div>
      </div>

      <!-- Active Prompt Line -->
      <form id="terminal-form" class="mt-3 flex items-center gap-2">
        <span class="shrink-0 font-bold select-none">
          <span class="text-green-400">pablo@portfolio</span>:<span class="text-blue-400">~</span>$
        </span>
        <input
          type="text"
          id="terminal-input"
          class="w-full bg-transparent font-mono text-neutral-100 outline-none caret-albero"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        />
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const modal = document.getElementById("terminal-modal");
    const windowEl = document.getElementById("terminal-window");
    const input = document.getElementById("terminal-input") as HTMLInputElement;
    const history = document.getElementById("terminal-history");
    const screen = document.getElementById("terminal-screen");
    const closeBtn = document.getElementById("terminal-btn-close");
    const form = document.getElementById("terminal-form");

    if (!modal || !windowEl || !input || !history || !screen) return;

    let commandHistory: string[] = [];
    let historyIndex = -1;

    const openTerminal = () => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      void modal.offsetWidth; // Reflow
      modal.classList.remove("opacity-0");
      modal.classList.add("opacity-100");
      windowEl.classList.remove("scale-95");
      windowEl.classList.add("scale-100");
      setTimeout(() => input.focus(), 150);
    };

    const closeTerminal = () => {
      modal.classList.remove("opacity-100");
      modal.classList.add("opacity-0");
      windowEl.classList.remove("scale-100");
      windowEl.classList.add("scale-95");
      setTimeout(() => {
        modal.classList.remove("flex");
        modal.classList.add("hidden");
      }, 300);
    };

    // Global event listener to open terminal from anywhere
    window.addEventListener("open-terminal", () => {
      openTerminal();
    });

    closeBtn?.addEventListener("click", closeTerminal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeTerminal();
    });

    screen.addEventListener("click", () => {
      input.focus();
    });

    // Keyboard navigation (Escape to close, Ctrl+` or Alt+T)
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        closeTerminal();
      }
      if ((e.altKey && (e.key === "t" || e.key === "T")) || (e.ctrlKey && e.key === "`")) {
        e.preventDefault();
        modal.classList.contains("hidden") ? openTerminal() : closeTerminal();
      }
    });

    const commands: Record<string, () => string> = {
      help: () => `
<div class="text-neutral-300">
  <p class="font-bold text-albero mb-1">COMANDOS DISPONIBLES:</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1 text-xs">
    <div><span class="text-green-400 font-semibold">neofetch</span> - Muestra specs del sistema y perfil</div>
    <div><span class="text-green-400 font-semibold">skills</span> - Desglose de habilidades técnicas</div>
    <div><span class="text-green-400 font-semibold">projects</span> - Lista de proyectos con enlaces</div>
    <div><span class="text-green-400 font-semibold">blog</span> - Últimos artículos técnicos publicados</div>
    <div><span class="text-green-400 font-semibold">about</span> - Resumen de trayectoria e intereses</div>
    <div><span class="text-green-400 font-semibold">contact</span> - Canales de contacto profesional</div>
    <div><span class="text-green-400 font-semibold">clear</span> - Limpiar pantalla</div>
    <div><span class="text-green-400 font-semibold">exit</span> - Cerrar terminal</div>
  </div>
</div>`,

      neofetch: () => `
<div class="flex flex-col sm:flex-row gap-4 items-start py-2">
  <pre class="text-red-500 font-bold select-none text-xs leading-none">
        ---
      /     \\
     | () () |
      \\  -  /
       \`---\`
      </pre>
  <div class="text-xs space-y-1">
    <p><span class="text-albero font-bold">pablo</span>@<span class="text-albero font-bold">portfolio</span></p>
    <p class="text-neutral-500">----------------------------</p>
    <p><span class="text-green-400 font-semibold">OS:</span> Ubuntu 24.04.1 LTS / Astro 5.x</p>
    <p><span class="text-green-400 font-semibold">Host:</span> Pablo Aranda Cortés</p>
    <p><span class="text-green-400 font-semibold">Education:</span> Grado en Ingeniería Informática (Sistemas de Inf.) @ UPO</p>
    <p><span class="text-green-400 font-semibold">Kernel:</span> Software Engineer & ML Specialist</p>
    <p><span class="text-green-400 font-semibold">Shell:</span> bash / zsh</p>
    <p><span class="text-green-400 font-semibold">Core Stack:</span> Java, Python, TypeScript, Spring Boot, Django, Docker</p>
    <p><span class="text-green-400 font-semibold">Interests:</span> Sistemas Distribuidos, Machine Learning, Hardware Modding, Sci-Fi</p>
  </div>
</div>`,

      skills: () => `
<div class="space-y-2 text-xs">
  <p><span class="text-blue-400 font-bold">Backend & Enterprise:</span> Java (Spring Boot), Python (Django, FastAPI), TypeScript, Node.js, PHP</p>
  <p><span class="text-purple-400 font-bold">Bases de Datos & Data:</span> PostgreSQL, MariaDB, SQLite (FTS5), MongoDB</p>
  <p><span class="text-green-400 font-bold">DevOps & Cloud:</span> Docker, Docker Compose, Ngrok, Git, Linux / Bash Scripting</p>
  <p><span class="text-yellow-400 font-bold">Frontend:</span> Astro, Tailwind CSS v4, Angular, React, Vanilla JS / HTML5</p>
  <p><span class="text-red-400 font-bold">Concurrencia & HPC:</span> Programación en C con OpenMP y MPI</p>
</div>`,

      projects: () => `
<div class="space-y-1 text-xs">
  <p class="font-bold text-albero mb-1">PROYECTOS DESTACADOS:</p>
  <p>• <a href="/projects/astro-portfolio-blog" class="text-green-400 underline hover:text-green-300">Astro Portfolio & Blog</a> - Arquitectura moderna SSG + SSR, Notion CMS y Gemini AI.</p>
  <p>• <a href="/projects/dashboard-analitico-tiempo-real" class="text-green-400 underline hover:text-green-300">Dashboard Analítico en Tiempo Real</a> - Angular, Chart.js y D3.js para métricas en streaming.</p>
  <p>• <a href="/projects/erp-odoo17" class="text-green-400 underline hover:text-green-300">ERP Empresarial Odoo 17</a> - Módulos personalizados en Python, PostgreSQL y OWL.</p>
  <p>• <a href="/projects/lms-django-docker" class="text-green-400 underline hover:text-green-300">Plataforma LMS Django</a> - Dockerizada con autenticación y arquitectura REST.</p>
  <p>• <a href="/projects/optimizacion-algoritmos-java" class="text-green-400 underline hover:text-green-300">Optimización & Metaheurísticas en Java</a> - Algoritmos genéticos y búsqueda local.</p>
  <p class="mt-2 text-neutral-400">Escribe <span class="text-white font-bold">'open &lt;slug&gt;'</span> o haz clic en cualquier enlace para visitarlo.</p>
</div>`,

      blog: () => `
<div class="space-y-1 text-xs">
  <p class="font-bold text-albero mb-1">ARTÍCULOS TÉCNICOS DESTACADOS:</p>
  <p>• <a href="/blog/algoritmo-de-dijkstra" class="text-green-400 underline hover:text-green-300">Algoritmo de Dijkstra</a> - Grafos y caminos mínimos con simulador interactivo.</p>
  <p>• <a href="/blog/attention-is-all-you-need" class="text-green-400 underline hover:text-green-300">Attention Is All You Need</a> - Mecanismos de atención y Transformers explicados.</p>
  <p>• <a href="/blog/notacion-big-o" class="text-green-400 underline hover:text-green-300">Notación Big O</a> - Complejidad computacional y optimización asintótica.</p>
  <p>• <a href="/blog/bot-telegram" class="text-green-400 underline hover:text-green-300">Bot de Telegram con Node.js</a> - Webhooks, polling y simulador en vivo.</p>
  <p class="mt-2 text-neutral-400">Visita <a href="/blog" class="text-albero underline">/blog</a> para ver todas las publicaciones.</p>
</div>`,

      about: () => `
<div class="text-xs space-y-2 text-neutral-300">
  <p>Pablo Aranda es estudiante de 4º año de Ingeniería Informática en Sistemas de Información en la Universidad Pablo de Olavide (Sevilla).</p>
  <p>Apasionado por la ingeniería de backend, las bases de datos de alto rendimiento, los modelos de Inteligencia Artificial y la computación paralela (OpenMP/MPI).</p>
  <p>En su tiempo libre: ávido lector de fantasía y ciencia ficción (Brandon Sanderson, Frank Herbert), aficionado al modding de consolas retro y entusiasta del diagnóstico de coches con OBD2.</p>
</div>`,

      contact: () => `
<div class="text-xs space-y-1.5">
  <p><span class="text-albero font-bold">Email:</span> <a href="mailto:pabloarandacortes02@gmail.com" class="text-neutral-200 underline">pabloarandacortes02@gmail.com</a></p>
  <p><span class="text-albero font-bold">LinkedIn:</span> <a href="https://linkedin.com/in/pablo-aranda-cortes" target="_blank" class="text-blue-400 underline">linkedin.com/in/pablo-aranda-cortes</a></p>
  <p><span class="text-albero font-bold">GitHub:</span> <a href="https://github.com/Pabl0Aranda" target="_blank" class="text-green-400 underline">github.com/Pabl0Aranda</a></p>
</div>`,

      whoami: () => `<p class="text-xs text-green-400">pablo (UID: 1000, GID: 1000 - Developer & Student)</p>`,

      sudo: () => `<p class="text-xs text-red-400">pablo is not in the sudoers file. This incident will be reported to Santa Claus.</p>`,
    };

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const rawInput = input.value.trim();
      input.value = "";

      if (!rawInput) return;

      commandHistory.push(rawInput);
      historyIndex = commandHistory.length;

      // Render the prompt that was just executed
      const promptLine = document.createElement("div");
      promptLine.className = "flex items-center gap-2 text-xs";
      promptLine.innerHTML = `
        <span class="font-bold select-none">
          <span class="text-green-400">pablo@portfolio</span>:<span class="text-blue-400">~</span>$
        </span>
        <span class="text-white">${rawInput.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</span>
      `;
      history.appendChild(promptLine);

      const [cmd, ...args] = rawInput.toLowerCase().split(" ");

      if (cmd === "clear") {
        history.innerHTML = "";
        return;
      }

      if (cmd === "exit") {
        closeTerminal();
        return;
      }

      const outputDiv = document.createElement("div");
      outputDiv.className = "text-xs pl-2 border-l-2 border-white/10 my-2";

      if (cmd === "cat" && args[0] === "about.txt") {
        outputDiv.innerHTML = commands.about();
      } else if (commands[cmd]) {
        outputDiv.innerHTML = commands[cmd]();
      } else {
        outputDiv.innerHTML = `<p class="text-red-400 text-xs">bash: command not found: ${cmd}. Type <span class="text-green-400 font-bold">'help'</span> for list of commands.</p>`;
      }

      history.appendChild(outputDiv);
      screen.scrollTop = screen.scrollHeight;
    });

    // Arrow Up / Down for command history
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowUp") {
        e.preventDefault();
        if (commandHistory.length > 0 && historyIndex > 0) {
          historyIndex--;
          input.value = commandHistory[historyIndex];
        }
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        if (historyIndex < commandHistory.length - 1) {
          historyIndex++;
          input.value = commandHistory[historyIndex];
        } else {
          historyIndex = commandHistory.length;
          input.value = "";
        }
      } else if (e.key === "Tab") {
        e.preventDefault();
        const cur = input.value.trim().toLowerCase();
        const match = Object.keys(commands).find((k) => k.startsWith(cur));
        if (match) input.value = match;
      }
    });
  });
</script>
